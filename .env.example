# APIEdge configuration. Copy to `.env` (never commit `.env`) or set real environment variables.
# All settings use the APIEDGE_ prefix. Documented in docs/admin-guide/configuration.md.

# production | development   (development enables /api/docs; never use it in production)
APIEDGE_ENV=production

# Data directory (database, keys, captures). Default: the OS user data dir, e.g.
#   Windows: %LOCALAPPDATA%\APIEdge\APIEdge   macOS: ~/Library/Application Support/APIEdge
#   Linux:   ~/.local/share/APIEdge
# APIEDGE_DATA_DIR=

# Database URL. Default: SQLite file in the data dir. PostgreSQL example:
# APIEDGE_DATABASE_URL=postgresql+psycopg://apiedge:CHANGE_ME@localhost:5432/apiedge

# Bind address and port of the console/admin API/gateway. Default: localhost only.
APIEDGE_HOST=127.0.0.1
APIEDGE_PORT=8080

# critical | error | warning | info | debug
APIEDGE_LOG_LEVEL=info
# json | text   (json: one masked JSON object per line; text: readable, also masked)
APIEDGE_LOG_FORMAT=json

# --- HTTP hardening (T-002) -------------------------------------------------------------
# Extra browser origins allowed to call the admin API with credentials (comma-separated,
# exact scheme://host[:port], "*" is rejected). Empty = same-origin only.
# APIEDGE_CORS_ALLOW_ORIGINS=https://portal.example.com
# Maximum request body size for the console/admin API, in bytes (default 2 MiB).
APIEDGE_MAX_REQUEST_BODY_BYTES=2097152
# HSTS max-age in seconds, sent only over HTTPS (0 disables).
APIEDGE_HSTS_MAX_AGE=31536000

# --- Secrets encryption at rest (T-002) -------------------------------------------------
# Master key (base64url, 32 bytes). Default: the key file <data dir>/secret.key, created by
# `apiedge init`. Generate one with:
#   python -c "from apiedge.security.crypto import generate_key; print(generate_key())"
# BACK IT UP: encrypted secrets cannot be recovered without it.
# APIEDGE_SECRET_KEY=
# Previous keys still accepted for decryption during rotation (comma-separated).
# APIEDGE_SECRET_KEY_PREVIOUS=
# APIEDGE_SECRET_KEY_FILE=

# --- SSRF guard for upstream URLs (T-002) -----------------------------------------------
# Private/loopback/link-local upstreams are blocked by default. On-prem installs that proxy to
# internal services can allow them all, or (better) allow-list specific CIDRs.
# Cloud metadata addresses stay blocked unless an allow CIDR names them explicitly.
APIEDGE_SSRF_ALLOW_PRIVATE=false
# APIEDGE_SSRF_ALLOW_CIDRS=10.20.0.0/16
# APIEDGE_SSRF_DENY_CIDRS=

# --- Console authentication (T-003) ----------------------------------------------------
# Access-token lifetime (seconds) and absolute sign-in session lifetime (hours).
APIEDGE_ACCESS_TOKEN_TTL_SECONDS=900
APIEDGE_REFRESH_TOKEN_TTL_HOURS=12
# Lock an account after N failed sign-ins for M minutes; limit sign-in attempts per client IP.
APIEDGE_LOGIN_MAX_FAILURES=5
APIEDGE_LOGIN_LOCKOUT_MINUTES=15
APIEDGE_LOGIN_RATE_LIMIT_PER_MINUTE=20
# Access-token signing key (>= 32 bytes). Default: derived from the secrets master key.
# APIEDGE_JWT_SECRET=
# Always mark session cookies Secure (behind a TLS-terminating reverse proxy).
APIEDGE_COOKIE_SECURE=false
